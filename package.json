{
  "name": "inbox-triage",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11 <12",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @inbox-triage/dashboard dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint apps packages *.config.mjs --max-warnings=0",
    "lint:fix": "eslint apps packages *.config.mjs --fix --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0"
  }
}
