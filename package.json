{
    "name": "inbox-triage",
    "private": true,
    "engines": {
        "node": ">=24 <25"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": ">=11 <12",
            "onFail": "download"
        }
    },
    "scripts": {
        "dev": "pnpm --filter @inbox-triage/dashboard dev",
        "build": "pnpm -r --if-present build",
        "lint": "pnpm -r --if-present lint",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "pnpm -r --if-present test",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "^3.9.6"
    }
}